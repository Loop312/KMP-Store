CREATE TABLE IF NOT EXISTS category (
    id TEXT NOT NULL PRIMARY KEY, -- Mapping UUID to TEXT
    name TEXT NOT NULL,
    slug TEXT NOT NULL,
    parent_id TEXT
);
CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON category(parent_id);

insertCategory:
INSERT INTO category(id, name, slug, parent_id)
VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    slug = excluded.slug,
    parent_id = excluded.parent_id;

selectAllCategories:
SELECT * FROM category;