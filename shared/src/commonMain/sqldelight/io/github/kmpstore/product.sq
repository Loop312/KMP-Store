CREATE TABLE IF NOT EXISTS product (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    image_url TEXT,
    price INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CAD',
    price_id TEXT NOT NULL,
    stock INTEGER NOT NULL
);

-- Updated to only include product-specific fields
insertProduct:
INSERT OR REPLACE INTO product(id, name, description, image_url, price, currency, price_id, stock)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Join query to get products for a specific category
selectProductsByCategoryId:
SELECT p.* FROM product p
JOIN category_products cp ON p.id = cp.product_id
WHERE cp.category_id = ?;

selectAllProducts:
SELECT * FROM product;

selectProductById:
SELECT * FROM product WHERE id = ?;

-- 1. For a single category view (Solution 1)
selectProductsByCategoryIdRecursive:
WITH RECURSIVE category_tree(id) AS (
    SELECT id FROM category WHERE id = :categoryId
    UNION ALL
    SELECT c.id FROM category c
    JOIN category_tree ct ON c.parent_id = ct.id
)
SELECT DISTINCT p.* FROM product p
JOIN category_products cp ON p.id = cp.product_id
WHERE cp.category_id IN category_tree;

-- 2. For the entire Storefront (Optimized)
selectAllCategoryProductsRecursive:
WITH RECURSIVE category_tree(root_id, current_id) AS (
    -- Anchor member: Start with every category as its own root
    SELECT id, id FROM category
    UNION ALL
    -- Recursive member: Find all children, keeping track of the original root_id
    SELECT ct.root_id, c.id
    FROM category c
    JOIN category_tree ct ON c.parent_id = ct.current_id
)
SELECT DISTINCT ct.root_id AS category_id, p.* FROM product p
JOIN category_products cp ON p.id = cp.product_id
JOIN category_tree ct ON cp.category_id = ct.current_id;