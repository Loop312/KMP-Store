CREATE TABLE IF NOT EXISTS product (
    id TEXT NOT NULL PRIMARY KEY,
    category_id TEXT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    price REAL NOT NULL,           -- SQLite doesn't have DECIMAL; use REAL or handle as Long (cents)
    currency TEXT NOT NULL DEFAULT 'CAD',
    image_url TEXT,
    stock_quantity INTEGER,
    created_at TEXT NOT NULL,
    FOREIGN KEY (category_id) REFERENCES category(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_products_category_id ON product(category_id);

insertProduct:
INSERT OR REPLACE INTO product(id, category_id, name, description, price, currency, image_url, stock_quantity, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectProductsByCategory:
SELECT * FROM product WHERE category_id = :categoryId;

selectAllProducts:
SELECT * FROM product;

deleteProduct:
DELETE FROM product WHERE id = ?;