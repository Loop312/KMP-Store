CREATE TABLE IF NOT EXISTS product (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    image_url TEXT,
    price INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'CAD',
    price_id TEXT NOT NULL,
    stock INTEGER NOT NULL
);

-- Updated to only include product-specific fields
insertProduct:
INSERT OR REPLACE INTO product(id, name, description, image_url, price, currency, price_id, stock)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- Join query to get products for a specific category
selectProductsByCategoryId:
SELECT p.* FROM product p
JOIN category_products cp ON p.id = cp.product_id
WHERE cp.category_id = ?;

selectAllProducts:
SELECT * FROM product;

selectProductById:
SELECT * FROM product WHERE id = ?;